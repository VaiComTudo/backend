# PostgreSQL Database Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=very_secure_trust
POSTGRES_DB=vaicomtudo_db

# Spring Boot Database Configuration
# For local development without Docker use localhost:5432 instead of db:5432
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/vaicomtudo_db
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=very_secure_trust

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_at_least_256_bits
